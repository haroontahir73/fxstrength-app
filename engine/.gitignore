# This .gitignore sits at engine/ (the pipeline subdir); paths are engine-relative.
#
# NOTE ON COMMENTS. git does NOT support trailing comments in .gitignore - a `#` only starts
# a comment at the START of a line. Every annotated pattern here used to be written as
# `data/cot_history.json    # [cache] ...`, which git read as a literal filename ending in
# spaces and a comment, so those files were never actually ignored. Keep every note on its
# own line. (`git check-ignore -v <path>` says which rule, if any, matched.)

# Python
__pycache__/
*.pyc

# The dashboard is built in the runner and deployed straight to Pages (not committed).
# Local runs and the Artifact publish still produce it here.
dashboard.html

# --- pipeline state: regenerated every run, do NOT commit (git-history bloat) ---
# The live dashboard needs none of these persisted between CI runs - each run rebuilds
# them from source. The ones marked [cache] are worth keeping in actions/cache to skip the
# rebuild cost or preserve an accumulation; everything else is fine to lose.

data/cot.json
# [cache] rebuildable in ~30s: run.py bootstrap (CFTC)
data/cot_history.json
# [cache] same
data/cot_history_commodity.json
data/calendar.json
# [cache] backtest_blend.py only; API paging makes a full rebuild lossy
data/calendar_history.json
# [cache] ForexFactory speaker archive - only ever serves the current week
data/ff_archive.json
data/ff_cache.json
data/oi.json
data/rates.json
# [cache] Fed Watch odds + the history the change flag compares against
data/fedwatch.json
data/rate_expectations.json
# [cache] accumulates 1 row/run for the rate-odds backtest
data/expectations_history.json
data/fundamentals.json
data/scores.json
# [cache] accumulates 1 row/run for RATING_BANDS calibration
data/score_history.json
data/commodities.json
# [cache] accumulates 1 row/run
data/commodity_history.json
data/prices_fx.json
data/prices_commodity.json
# derived from the live calendars + speech_tone.json
data/speakers.json
data/state.json
data/refresh.log
# [cache] news_watch.py dedup state (TTL-pruned anyway)
data/news_seen.json
# local-test ntfy topic; CI uses the NTFY_TOPIC secret
data/ntfy_topic.txt
# rebuilt from calendar.json every run - a record, not a source
data/flagship.json
# [cache] oi.py retry-window bookkeeping
data/oi_state.json
# built by oi.py in the runner, copied to _site
open-interest.html

# --- the add-on tabs (matrix / yields / sentiment / seasonality / indices) ---
data/yields.json
# [cache] 1 row/run; the front-end momentum leg needs ~21 days before it reads anything
data/yields_history.json
# [cache] EXPENSIVE - 34 Yahoo pulls of 15 years of history, ~4 minutes. Self-caches for
# 7 days and only force-refreshes on a `cot` run, so losing the cache costs one slow
# Saturday rather than a slow run every 30 minutes.
data/seasonality.json
data/sentiment.json
data/indices.json
data/matrix.json
data/prices_index.json

# --- COMMITTED (small, human/Claude-authored, the fx-strength-desk-daily task edits these) ---
#   data/fundamentals_manual.json
#   data/commodities_manual.json
#   data/indices_manual.json
#   data/rate_expectations_manual.json
#   data/speech_tone.json
#   data/oi_history.json            <- seeded from the user's Excel workbook; CME may be
#                                      unreachable from CI, so this must NOT live only in
#                                      the cache. It is pinned in refresh.yml.
#   dashboard.html                  <- the Action writes this; Pages serves it
data/prices_dxy.json
data/dxy.json
data/ticker.json

# --- FRED (US breakevens / true real yields) ---
data/fred.json
# THE API KEY. Never commit this - the repo is public. CI supplies it as the FRED_API_KEY
# repo secret instead; this file is the local-only alternative.
data/fred_key.txt
